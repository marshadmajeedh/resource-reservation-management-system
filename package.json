{
  "name": "resource-reservation-management-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/helpers/register-resolver.mjs --test tests/validation.test.ts tests/cookies.test.ts tests/db-constraints.test.ts tests/auth.test.ts tests/resource-management.test.ts tests/reservations.test.ts tests/staff-management.test.ts",
    "test:validation": "node --experimental-strip-types --import ./tests/helpers/register-resolver.mjs --test tests/validation.test.ts",
    "test:db": "node --experimental-strip-types --import ./tests/helpers/register-resolver.mjs --test tests/db-constraints.test.ts",
    "test:auth": "node --experimental-strip-types --import ./tests/helpers/register-resolver.mjs --test tests/auth.test.ts",
    "test:resources": "node --experimental-strip-types --import ./tests/helpers/register-resolver.mjs --test tests/resource-management.test.ts",
    "test:reservations": "node --experimental-strip-types --import ./tests/helpers/register-resolver.mjs --test tests/reservations.test.ts",
    "test:staff": "node --experimental-strip-types --import ./tests/helpers/register-resolver.mjs --test tests/staff-management.test.ts",
    "test:cookies": "node --experimental-strip-types --test tests/cookies.test.ts",
    "create-admin": "node --experimental-strip-types scripts/create-admin.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
