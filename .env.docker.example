# ==============================================================================
# Docker Environment Configuration (.env.docker)
# ==============================================================================
# Copy this file to .env.docker before running docker compose:
#   cp .env.docker.example .env.docker
#
# IMPORTANT ARCHITECTURE & SECURITY NOTES:
# 1. This file is strictly for local Docker Compose runs. Keep it separate from
#    the root .env file used for native Node + Supabase development.
# 2. Never commit .env.docker containing real passwords or secrets to Git.
# 3. Special characters in POSTGRES_PASSWORD (such as @, :, #, %, /) are automatically
#    URL-encoded by our entrypoint when constructing the internal database URI.
# ==============================================================================

# PostgreSQL Credentials (used by both the 'db' container and internal connection string)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_db_password
POSTGRES_DB=reservation_db

# Application Host Port (mapped on 127.0.0.1:<APP_PORT>:3000)
APP_PORT=3000

# Node Environment
NODE_ENV=production

# JWT Authentication Secret Key
# Generate a secure secret using openssl or a temporary container:
#   openssl rand -base64 32
#   docker run --rm node:24-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace_with_a_secure_random_32_plus_character_secret

# Cookie Security Flag for Local HTTP Review
# In production, cookies default to Secure=true (requiring HTTPS).
# For local Docker review over plain HTTP (http://localhost:3000), set COOKIE_SECURE=false.
# In actual production deployments behind TLS, set to true or omit.
COOKIE_SECURE=false
