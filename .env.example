# Database connection (PostgreSQL / Supabase Session Pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Isolated disposable test database connection (used for local/CI automated constraint testing)
# Never point this to hosted production or Supabase databases!
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rrs_test?sslmode=disable"

# Authentication secret for signing JWT tokens
JWT_SECRET="your-secure-random-jwt-secret-placeholder"
